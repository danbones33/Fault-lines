# The app's Settings button writes these for you. Or copy this file to .env (never committed) and edit it by hand.
# Every key is optional: leave them blank to run fully local on Ollama, or with nothing at all for demo runs.
# KEY=VALUE lines only, and no comments on the same line as a value. A variable already set in your environment wins.

# --- text models ---
# Cloud text for debates and season rollovers, and Flux images.
OPENROUTER_API_KEY=
# OpenRouter models for agents and the judge when they are not local (defaults in config.yaml).
AGENT_MODEL=
JUDGE_MODEL=
# auto | openrouter | ollama | hybrid (default: auto).
LLM_PROVIDER=
# Ollama model (default: qwen2.5:14b).
LOCAL_MODEL=

# --- images ---
# OpenRouter image model (default: black-forest-labs/flux-3-image-klein).
IMAGE_MODEL=
MEMES_PER_ROUND=

# --- voices ---
# auto | fish | cartesia | none (auto = Fish if its key is set, else Cartesia).
TTS_PROVIDER=
# With no voice key: off (silent, words on screen; the default) | browser (the browser reads them aloud).
FL_FALLBACK_VOICE=
CARTESIA_API_KEY=
CARTESIA_MODEL=
CARTESIA_USD_PER_CHAR=
# Optional: pin a Cartesia voice id to one state's field reporter. Any state code works (CARTESIA_VOICE_STATE_TX, ...).
CARTESIA_VOICE_STATE_PA=
FISH_AUDIO_API_KEY=
FISH_MODEL=
FISH_USD_PER_CHAR=

# --- video and avatars (off by default) ---
# none | fal
VIDEO_PROVIDER=
VIDEO_MODEL=
VIDEO_USD_PER_CLIP=
FAL_KEY=
# none | omnihuman
AVATAR_PROVIDER=
AVATAR_USD_PER_CLIP=
OMNIHUMAN_ENDPOINT=
OMNIHUMAN_API_KEY=

# --- spend guard ---
# Per-run cap on paid media in dollars (default 5).
RUN_BUDGET_USD=

# --- paths ---
# Default: ../mirofish/backend next to this folder.
MIROFISH_BACKEND=
